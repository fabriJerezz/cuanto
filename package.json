{
  "name": "cuanto",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build && pnpm audit:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.44.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
